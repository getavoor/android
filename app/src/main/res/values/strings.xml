    <!-- nux - calendar usage -->
    <string name="nux_calendar_usage_title">Let\'s see your schedule</string>
    <string name="nux_calendar_usage_desc">Avoor reads your calendar so the timer knows what you\'re supposed to be working on. Nothing is added or changed without your permission, and your calendar data stays on your device.</string>
    <string name="nux_permission_allow">Allow</string>
    <string name="nux_notification_usage_title">One more thing…</string>
    <string name="nux_notification_usage_desc">Avoor needs notifications to keep the timer running in the background. Without it, your device might cut it off mid-session.</string>
    <!-- nux - streaks -->
    <string name="nux_streak_title">Your streak</string>
    <string name="nux_streak_body_phase1">Time for the fun part! This is your streak. Your streak counts every day you use the timer. Let\'s get day 1 out of the way.</string>
    <string name="nux_streak_body_phase2">
        Skip a day, the streak resets. But life happens, and that\'s where streak pauses save you. A streak pause protects your streak from getting reset. You only have 3 of them.
    </string>
    <!-- nux - plancoins -->
    <string name="nux_plancoin_title">Plancoins</string>
    <string name="nux_plancoin_body">
        Plancoins are Avoor\'s official currency — totally fake, yet weirdly satisfying to earn. Earn them by tracking time using the timer, then spend them on rewards you choose yourself. So — what\'s the first thing you want to spend them on?
    </string>
    <!-- nux - end -->
    <string name="nux_end_title">That\'s it!</string>
    <string name="nux_end_desc_generic">You\'re now ready to use Avoor.</string>
    <string name="nux_end_desc_event_soon">%s is coming up — perfect time to try out Avoor in action.</string>
    <string name="nux_end_desc_event_now">Looks like you\'re in the middle of %s — want to time the rest of it?</string>

